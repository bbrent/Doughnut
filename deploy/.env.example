# Copy to .env (next to app.js) and fill in, or set these in your host's
# environment settings instead. Anything set in the environment wins over .env.

# The site's public address, used in links in emails. Use https.
PUBLIC_URL=https://doughnut.example.com

# Usually set by the host. Leave out unless told otherwise.
# PORT=3000

# MySQL / MariaDB: create an empty database and a user with full rights on it.
# Tables are created and upgraded automatically on start.
DATABASE_URL=mysql://doughnut_user:CHANGE_ME@localhost:3306/doughnut
# Or separately:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=doughnut_user
# MYSQL_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=doughnut

# Outgoing email (sign-up confirmations, password resets). Without SMTP_HOST,
# emails are written to the app log instead of sent.
SMTP_HOST=mail.example.com
SMTP_PORT=587
# SMTP_SECURE=true        # for port 465
SMTP_USER=no-reply@example.com
SMTP_PASS=CHANGE_ME
MAIL_FROM="Doughnut <no-reply@example.com>"
